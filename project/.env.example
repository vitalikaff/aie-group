# Пример переменных окружения для сервиса.
# Скопируйте этот файл в `.env` и при необходимости подправьте значения.
# Реальный `.env` НЕ должен попадать в репозиторий (см. .gitignore).

# Путь к конфигурационному файлу
POLYP_CONFIG_PATH=configs/config.yaml

# Какая модель используется в сервисе: baseline | final
POLYP_MODEL_ACTIVE=final

# Устройство: cpu | cuda
POLYP_DEVICE=cpu

# Параметры сервиса
POLYP_SERVICE_HOST=0.0.0.0
POLYP_SERVICE_PORT=8000
POLYP_LOG_LEVEL=INFO
